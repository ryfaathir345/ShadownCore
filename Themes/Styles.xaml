<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
        <ResourceDictionary Source="CardStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Sidebar Navigation RadioButton Style (Windows 11 Settings Style) -->
    <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="grid">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <!-- Indicator Bar -->
                                <Rectangle x:Name="activeIndicator"
                                           Width="3"
                                           Height="18"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Fill="{StaticResource PrimaryAccentBrush}"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Visibility="Collapsed" />

                                <ContentPresenter HorizontalAlignment="Left" 
                                                  VerticalAlignment="Center" 
                                                  Margin="10,0,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1E1E30" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#25253C" />
                            <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
