<UserControl x:Class="WinTweakStudio.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Tweak Execution History &amp; Backup" Foreground="#F8F9FA" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Review atomic SQLite logs, undo individual changes, or restore baseline state." Foreground="#9CA3AF" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="+ Create Restore Point" Command="{Binding CreateNewPointCommand}" Style="{StaticResource RevertButtonStyle}" Margin="0,0,12,0" Padding="14,8"/>
                <Button Content="Restore All to Baseline" Command="{Binding RestoreAllCommand}" Style="{StaticResource ApplyButtonStyle}" Background="#E74C3C" Foreground="#FFFFFF" Padding="16,8"/>
            </StackPanel>
        </Grid>

        <!-- Restore Points Selector -->
        <Border Grid.Row="1" Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Active Restore Point:" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding RestorePoints}" 
                          SelectedItem="{Binding SelectedRestorePoint}"
                          DisplayMemberPath="Label"
                          Background="#141422" Foreground="#FFFFFF" Padding="10,6" BorderThickness="1" BorderBrush="#2A2A42"/>
            </Grid>
        </Border>

        <!-- Logs Table -->
        <Border Grid.Row="2" Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="8" Padding="16">
            <DataGrid ItemsSource="{Binding Logs}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      Background="Transparent" 
                      RowBackground="#181825" 
                      AlternatingRowBackground="#1E1E30"
                      Foreground="#F8F9FA" 
                      GridLinesVisibility="Horizontal" 
                      HorizontalGridLinesBrush="#2A2A42"
                      BorderThickness="0"
                      HeadersVisibility="Column">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#141422" />
                        <Setter Property="Foreground" Value="#00E5FF" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="#2A2A42" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Padding" Value="8" />
                        <Setter Property="Height" Value="42" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding DisplayIndex}" Width="50"/>
                    <DataGridTextColumn Header="Applied At" Binding="{Binding AppliedAt}" Width="150"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Tweak Name" Binding="{Binding TweakName}" Width="200"/>
                    <DataGridTextColumn Header="Old Value (Backup)" Binding="{Binding OldValue}" Width="140"/>
                    <DataGridTextColumn Header="New Value" Binding="{Binding NewValue}" Width="140"/>
                    
                    <!-- Status Column -->
                    <DataGridTemplateColumn Header="Status" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="6,2" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#262ECC71" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                                    <Setter Property="Background" Value="#26E74C3C" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Applied" />
                                                <Setter Property="Foreground" Value="#2ECC71" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                                        <Setter Property="Text" Value="Reverted" />
                                                        <Setter Property="Foreground" Value="#E74C3C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Action Column -->
                    <DataGridTemplateColumn Header="Action" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Undo Item" 
                                        Command="{Binding DataContext.UndoLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}"
                                        Padding="10,4"
                                        FontSize="11"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RevertButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReverted}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
