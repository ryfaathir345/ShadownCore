<Window x:Class="WinTweakStudio.Views.DnsSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Custom DNS Provider" Height="320" Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1A1A28" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border Background="#2600E5FF" Padding="8,3" CornerRadius="4" Margin="0,0,10,0">
                    <TextBlock Text="DNS SELECTOR" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" />
                </Border>
                <TextBlock Text="Pilih Provider Custom DNS" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Radio Group -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <RadioButton x:Name="RbCloudflare" Content="Cloudflare (1.1.1.1 / 1.0.0.1) — Ultra Fast &amp; Private" IsChecked="True" Foreground="#F8F9FA" FontSize="13" Margin="0,0,0,12"/>
                <RadioButton x:Name="RbGoogle" Content="Google (8.8.8.8 / 8.8.4.4) — Reliable Global DNS" Foreground="#F8F9FA" FontSize="13" Margin="0,0,0,12"/>
                <RadioButton x:Name="RbQuad9" Content="Quad9 (9.9.9.9 / 149.112.112.112) — Security &amp; Malware Block" Foreground="#F8F9FA" FontSize="13"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource RevertButtonStyle}" Width="90" Margin="0,0,10,0"/>
                <Button Content="Apply Selected DNS" Click="OnConfirmClick" Style="{StaticResource ApplyButtonStyle}" Width="160"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
