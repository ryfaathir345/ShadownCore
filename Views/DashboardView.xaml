<UserControl x:Class="WinTweakStudio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <!-- Header Banner -->
            <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="WinTweakStudio" Foreground="#00E5FF" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Real-Time Hardware Monitor &amp; System Optimization Suite" Foreground="#9CA3AF" FontSize="14" />
                        
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border Background="#25253C" Padding="10,4" CornerRadius="6" Margin="0,0,12,0">
                                <TextBlock Text="{Binding OsVersion}" Foreground="#F8F9FA" FontSize="12" FontWeight="Medium" />
                            </Border>
                            <Border Background="#1A3A35" Padding="10,4" CornerRadius="6" Margin="0,0,12,0">
                                <TextBlock Text="● Admin Rights Active" Foreground="#00E5FF" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#1E2A38" Padding="10,4" CornerRadius="6">
                                <TextBlock Text="● LibreHardwareMonitor Active" Foreground="#3498DB" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Refresh Sensors" Command="{Binding RefreshCommand}" Style="{StaticResource RevertButtonStyle}" VerticalAlignment="Top" Padding="16,8"/>
                </Grid>
            </Border>

            <!-- 🚀 1-CLICK GAME MODE & PERFORMANCE PROFILES BANNER -->
            <Border Background="#1E1E30" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialIcons:MaterialIcon Kind="RocketLaunch" Width="24" Height="24" Foreground="#00E5FF" Margin="0,0,10,0"/>
                            <TextBlock Text="1-CLICK GAME MODE BOOSTER" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                            <!-- Auto Game Detection Badge -->
                            <Border Background="#25253C" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialIcons:MaterialIcon Kind="Radar" Width="14" Height="14" Foreground="#00E5FF" Margin="0,0,4,0"/>
                                    <TextBlock Text="Auto Game Detect: ACTIVE" Foreground="#00E5FF" FontSize="10.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Mematikan background app pengganggu, unpark CPU core, dan maksimalkan prioritas GPU/CPU untuk FPS &amp; Latency terendah." Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Toggle Game Mode Button -->
                    <Button Grid.Column="1" Command="{Binding ToggleGameModeCommand}" Cursor="Hand" Padding="20,12" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ApplyButtonStyle}">
                                <Setter Property="Background" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#0A0A14"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProfileService.IsGameModeActive}" Value="True">
                                        <Setter Property="Background" Value="#2ECC71"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="GamepadVariant" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock FontSize="14" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⚡ BOOST GAME MODE ON"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProfileService.IsGameModeActive}" Value="True">
                                                <Setter Property="Text" Value="✅ GAME MODE ACTIVE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 🎯 PERFORMANCE PROFILES SELECTION -->
            <TextBlock Text="Performance Profiles" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Profile: Gaming -->
                <Button Command="{Binding SelectProfileCommand}" CommandParameter="Gaming" Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" Padding="14" Margin="0,0,6,0" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Controller" Width="26" Height="26" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Gaming" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Max FPS &amp; Low Latency" Foreground="#6C757D" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Profile: Streaming -->
                <Button Command="{Binding SelectProfileCommand}" CommandParameter="Streaming" Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" Padding="14" Margin="6,0,6,0" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="VideoInputAntenna" Width="26" Height="26" Foreground="#9B59B6" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Streaming" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Encoder &amp; Network Priority" Foreground="#6C757D" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Profile: Work / Daily -->
                <Button Command="{Binding SelectProfileCommand}" CommandParameter="Work" Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" Padding="14" Margin="6,0,6,0" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="BriefcaseCheck" Width="26" Height="26" Foreground="#3498DB" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Work / Daily" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Responsive &amp; Balanced RAM" Foreground="#6C757D" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Profile: Battery Saver -->
                <Button Command="{Binding SelectProfileCommand}" CommandParameter="BatterySaver" Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" Padding="14" Margin="6,0,0,0" Cursor="Hand">
                    <StackPanel HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Leaf" Width="26" Height="26" Foreground="#2ECC71" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Battery Saver" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cool &amp; Low Power Draw" Foreground="#6C757D" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- 🛠️ 1-CLICK TROUBLESHOOT & DRIVER SCANNER CARDS -->
            <UniformGrid Columns="2" Margin="0,0,0,24">
                <!-- Troubleshoot Card -->
                <Border Background="#1E1E30" BorderBrush="#3498DB" BorderThickness="1.5" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialIcons:MaterialIcon Kind="Wrench" Width="22" Height="22" Foreground="#3498DB" Margin="0,0,8,0"/>
                            <TextBlock Text="1-CLICK TROUBLESHOOT FIX" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Reset Winsock, TCP/IP stack, Flush DNS Cache, dan bersihkan cache Windows Update bermasalah secara otomatis." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Button Content="🔧 Fix System &amp; Network Now" Command="{Binding RunFullSystemFixCommand}" Style="{StaticResource RevertButtonStyle}" HorizontalAlignment="Left" Padding="14,8"/>
                    </StackPanel>
                </Border>

                <!-- Driver Scanner Card -->
                <Border Background="#1E1E30" BorderBrush="#2ECC71" BorderThickness="1.5" CornerRadius="10" Padding="20" Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialIcons:MaterialIcon Kind="ShieldCheck" Width="22" Height="22" Foreground="#2ECC71" Margin="0,0,8,0"/>
                            <TextBlock Text="DRIVER VERIFIED STATUS" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Memeriksa integritas dan ketersediaan driver GPU (NVIDIA/AMD/Intel) &amp; Controller Audio." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding DriverList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="● " Foreground="{Binding StatusColor}" FontSize="12"/>
                                        <TextBlock Text="{Binding DeviceName}" Foreground="#F8F9FA" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                        <TextBlock Text="{Binding DriverVersion, StringFormat='v{0}'}" Foreground="#9CA3AF" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick Summary Stat Cards -->
            <UniformGrid Columns="2" Margin="0,0,0,24">
                <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total Tweaks Applied" Foreground="#9CA3AF" FontSize="13" />
                        <TextBlock Text="{Binding TotalTweaksApplied}" Foreground="#00E5FF" FontSize="36" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="Active modifications logged in SQLite" Foreground="#6C757D" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="10" Padding="20" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Restore Points Available" Foreground="#9CA3AF" FontSize="13" />
                        <TextBlock Text="{Binding TotalRestorePoints}" Foreground="#2ECC71" FontSize="36" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="System snapshot safety baselines" Foreground="#6C757D" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Hardware Sensor Cards Section Title -->
            <TextBlock Text="Real-Time Hardware Metrics" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- 2-Column Grid for Hardware Sensor Cards -->
            <UniformGrid Columns="2" Margin="0,0,0,24">
                
                <!-- CARD: CPU -->
                <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,12,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Cpu64Bit" Width="22" Height="22" Foreground="#00E5FF" Margin="0,0,10,0"/>
                                <TextBlock Text="CPU Processor" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#2600E5FF" Padding="8,3" CornerRadius="4">
                                <TextBlock Text="{Binding CpuTempText}" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding CpuName}" Foreground="#9CA3AF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>

                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Usage" Foreground="#6C757D" FontSize="11"/>
                                <TextBlock Text="{Binding CpuUsageText}" Foreground="#F8F9FA" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Power Draw" Foreground="#6C757D" FontSize="11"/>
                                <TextBlock Text="{Binding CpuPowerText}" Foreground="#F8F9FA" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Temp" Foreground="#6C757D" FontSize="11"/>
                                <TextBlock Text="{Binding CpuTempText}" Foreground="#00E5FF" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Core Clocks List -->
                        <TextBlock Text="Core Clocks Speed:" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding CpuCoreClocks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141422" CornerRadius="4" Padding="6,4" Margin="2">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding CoreName}" Foreground="#6C757D" FontSize="9.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ClockSpeedMHz, StringFormat='{}{0} MHz'}" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- CARD(S): GPU Graphics Collection (Multi-GPU Support) -->
                <ItemsControl ItemsSource="{Binding DetectedGpus}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="10" Padding="20" Margin="12,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ExpansionCard" Width="22" Height="22" Foreground="#2ECC71" Margin="0,0,10,0"/>
                                            <TextBlock Text="GPU Graphics" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

                                            <!-- iGPU / dGPU Badge Tag -->
                                            <Border Background="#25253C" Padding="6,2" CornerRadius="4" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GpuTypeBadge}" Foreground="#00E5FF" FontSize="11" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Active Badge Tag -->
                                            <Border Padding="6,2" CornerRadius="4" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="● Aktif" Foreground="#2ECC71" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <Border HorizontalAlignment="Right" Background="#262ECC71" Padding="8,3" CornerRadius="4">
                                            <TextBlock Text="{Binding Temperature, StringFormat='{}{0} °C'}" Foreground="#2ECC71" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" Foreground="#9CA3AF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>

                                    <UniformGrid Columns="3" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="GPU Usage" Foreground="#6C757D" FontSize="11"/>
                                            <TextBlock Text="{Binding UsagePercent, StringFormat='{}{0}%'}" Foreground="#F8F9FA" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Power Draw" Foreground="#6C757D" FontSize="11"/>
                                            <TextBlock Text="{Binding PowerWatts, StringFormat='{}{0} W'}" Foreground="#F8F9FA" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="VRAM Used" Foreground="#6C757D" FontSize="11"/>
                                            <TextBlock Text="{Binding VramFormatted}" Foreground="#F8F9FA" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- CARD: RAM -->
                <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,12,12,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Memory" Width="22" Height="22" Foreground="#F39C12" Margin="0,0,10,0"/>
                                <TextBlock Text="RAM Memory" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#26F39C12" Padding="8,3" CornerRadius="4">
                                <TextBlock Text="{Binding RamUsagePercentText}" Foreground="#F39C12" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <UniformGrid Columns="3" Margin="0,10,0,12">
                            <StackPanel>
                                <TextBlock Text="Used / Total" Foreground="#6C757D" FontSize="11"/>
                                <TextBlock Text="{Binding RamUsageText}" Foreground="#F8F9FA" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Usage %" Foreground="#6C757D" FontSize="11"/>
                                <TextBlock Text="{Binding RamUsagePercentText}" Foreground="#F8F9FA" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Detected Speed" Foreground="#6C757D" FontSize="11"/>
                                <TextBlock Text="{Binding RamSpeedText}" Foreground="#F39C12" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="⚡ Quick RAM Flush" Command="{Binding ClearStandbyMemoryCommand}" Style="{StaticResource RevertButtonStyle}" Margin="0,0,8,0" Padding="10,5"/>
                            <CheckBox IsChecked="{Binding IsAutoRamCleanEnabled}" Content="Auto Flush Tiap 30 Menit" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CARD: Battery & Power Status (Always Visible) -->
                <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="10" Padding="20" Margin="12,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Battery" Width="22" Height="22" Foreground="#9B59B6" Margin="0,0,10,0"/>
                                <TextBlock Text="Battery &amp; Power Status" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#269B59B6" Padding="8,3" CornerRadius="4">
                                <TextBlock Text="{Binding BatteryChargeText}" Foreground="#9B59B6" FontSize="12" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding BatteryStatusText}" Foreground="#9CA3AF" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"/>

                        <UniformGrid Columns="2" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Charge Level" Foreground="#6C757D" FontSize="11"/>
                                <TextBlock Text="{Binding BatteryChargeText}" Foreground="#F8F9FA" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Health / Wear Level" Foreground="#6C757D" FontSize="11"/>
                                <TextBlock Text="{Binding BatteryWearLevelText}" Foreground="#9B59B6" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- CARD: Cooling & Fan Speed Monitor -->
            <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Fan" Width="22" Height="22" Foreground="#00E5FF" Margin="0,0,10,0"/>
                            <TextBlock Text="Cooling &amp; Laptop Fan Speed Monitor" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" Background="#2600E5FF" Padding="8,3" CornerRadius="4">
                            <TextBlock Text="{Binding PrimaryFanSpeedText}" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding FanSensors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141422" BorderBrush="#25253C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <materialIcons:MaterialIcon Kind="FanAuto" Width="16" Height="16" Foreground="#00E5FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#F8F9FA" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Background="#25253C" Padding="6,2" CornerRadius="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Location}" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Medium"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Duty / PWM: " Foreground="#6C757D" FontSize="12"/>
                                                <TextBlock Text="{Binding ControlFormatted}" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding RpmFormatted}" Foreground="#2ECC71" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Fallback message if no fans detected (e.g. passive cooling or restricted EC) -->
                    <Border Background="#141422" BorderBrush="#25253C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFansDetected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="18" Height="18" Foreground="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kipas berjalan dalam mode Otomatis / Pasif, atau pembacaan sensor EC memerlukan hak akses SuperIO Admin." Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CARD: Storage Drives Section -->
            <Border Background="#1E1E30" BorderBrush="#2A2A42" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Harddisk" Width="22" Height="22" Foreground="#E67E22" Margin="0,0,10,0"/>
                            <TextBlock Text="Storage Drives &amp; SMART Health" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding StorageDrives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141422" BorderBrush="#25253C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#26E67E22" Padding="6,2" CornerRadius="4" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DriveType}" Foreground="#E67E22" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Foreground="#F8F9FA" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="Space Used: " Foreground="#6C757D" FontSize="12"/>
                                                <TextBlock Text="{Binding UsagePercent, StringFormat='{}{0}%'}" Foreground="#9CA3AF" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0"/>
                                                
                                                <TextBlock Text="Health: " Foreground="#6C757D" FontSize="12"/>
                                                <TextBlock Text="{Binding HealthPercent, StringFormat='{}{0}%'}" Foreground="#2ECC71" FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Temperature, StringFormat='{}{0} °C'}" Foreground="#00E5FF" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
