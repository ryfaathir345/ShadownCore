<Window x:Class="WinTweakStudio.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="Notification" Height="220" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#1A1A28" BorderBrush="#00E5FF" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border x:Name="BadgeBorder" Background="#2600E5FF" Padding="8,3" CornerRadius="4" Margin="0,0,10,0">
                    <TextBlock x:Name="TxtBadge" Text="SYSTEM INFO" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" />
                </Border>
                <TextBlock x:Name="TxtTitle" Text="Notification" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="TxtMessage" Grid.Row="1" TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="13" LineHeight="18" Margin="0,0,0,16"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Click="OnOkClick" Style="{StaticResource ApplyButtonStyle}" Width="100" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
