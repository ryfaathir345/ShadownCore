<Window x:Class="WinTweakStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinTweakStudio.ViewModels"
        xmlns:views="clr-namespace:WinTweakStudio.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="WinTweakStudio - Windows 11 Performance Optimizer" 
        Icon="/Icon/App_Icon.png"
        Height="780" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoryViewModel}">
            <views:CategoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="240" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation (Windows 11 Settings Style) -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,20,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding Header -->
                <Border Grid.Row="0" Margin="-4,0,-4,16" HorizontalAlignment="Stretch">
                    <Image Source="/Icon/Sidebar.png" Height="85" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                </Border>

                <!-- 12 Navigation Items List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Main -->
                        <RadioButton IsChecked="True" 
                                     Command="{Binding NavigateCommand}" 
                                     CommandParameter="Dashboard" 
                                     Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ViewDashboard" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="HARDWARE" Foreground="#52527A" FontSize="10.5" FontWeight="Bold" Margin="14,14,0,6"/>
                        
                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="GPU" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ExpansionCard" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="GPU Tuning" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="CPU" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Cpu64Bit" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="CPU Processor" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="RAM" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Memory" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="RAM Memory" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Network" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="LanConnect" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Network &amp; Latency" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="SYSTEM" Foreground="#52527A" FontSize="10.5" FontWeight="Bold" Margin="14,14,0,6"/>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Windows" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="MicrosoftWindows" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Windows Tweaks" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Service" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Cog" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Services" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Debloat" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="DeleteSweep" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Debloat Apps" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Storage" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Harddisk" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Storage &amp; Disk" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="BootPower" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Power" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Boot &amp; Power" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="MANAGEMENT" Foreground="#52527A" FontSize="10.5" FontWeight="Bold" Margin="14,14,0,6"/>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="History" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="History" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="History &amp; Logs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavTabButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Tune" Width="20" Height="20" Margin="0,0,10,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer (User info & Role Badge) -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <!-- System connection status (smaller) -->
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,6">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#2ECC71" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="System Connected" Foreground="#52527A" FontSize="10" FontWeight="Medium"/>
                    </StackPanel>
                    <!-- User Profile Card -->
                    <Border Background="#1B1B2C" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#2A2A42" Margin="0,0,10,0" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Account" Width="18" Height="18" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding License.Username}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding License.RoleBadgeText}" Foreground="{Binding License.RoleBadgeColor, Converter={StaticResource StringToBrushConverter}}" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <!-- Logout Button -->
                            <Button Grid.Column="2" Command="{Binding LogoutCommand}" ToolTip="Log Out / Ganti Akun" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Padding="4,2">
                                <materialIcons:MaterialIcon Kind="Logout" Width="16" Height="16" Foreground="#9CA3AF"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Top Header Bar -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#141422" BorderBrush="#2A2A42" BorderThickness="0,0,0,1" Padding="24,12">
                <Grid>
                    <!-- Current Category Title / Breadcrumb -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="MicrosoftWindows" Width="18" Height="18" Foreground="#00E5FF" Margin="0,0,8,0"/>
                        <TextBlock Text="WinTweakStudio" Foreground="#9CA3AF" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text=" / " Foreground="#52527A" FontSize="13" Margin="4,0"/>
                        <TextBlock Text="{Binding ActiveCategoryName}" Foreground="#F8F9FA" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Restart PC Button (Visible only when HasAppliedTweaks is true) -->
                    <Button HorizontalAlignment="Right" 
                            Command="{Binding RestartPcCommand}"
                            Padding="14,6"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ApplyButtonStyle}">
                                <Setter Property="Background" Value="#EF4444" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAppliedTweaks}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Restart" Width="16" Height="16" Margin="0,0,6,0" Foreground="#FFFFFF"/>
                            <TextBlock Text="Restart PC untuk Apply Tweak" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content Host -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
